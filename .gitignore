# Local implementation snapshots and dependency/test runtime.
/.implementation-backup/
/.pipeline-runtime/

# Python runtime and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Keep Core/Data, generators, tests, _fc/data, _fc/inputs (including frozen
# faction-sources/*.db2 and JSON), maintenance and translation dictionaries.
# Do not ignore all _temp/ or all JSON/CSV/HTML/Lua/DB2 files.

# Historical profession pipeline: cache/report outputs only.
/df-prof-pipeline-v1.0/_temp/_fc/cache/
/df-prof-pipeline-v1.0/_temp/_fc/reports/

# Full data pipeline: known cache directories and temporary translation batches.
/df-data-pipeline/_temp/_fc/cache/
/df-data-pipeline/_temp/_fc/cache_zh/
/df-data-pipeline/_temp/_fc/reports/
/df-data-pipeline/_temp/_fc/i18n/batch_*.txt
/df-data-pipeline/_temp/_fc/i18n/zh_*.txt
/df-data-pipeline/_temp/_fc/i18n/todo.json

# Browser profiles and session state.
/df-data-pipeline/_temp/_qqb_profile*/
/df-data-pipeline/_temp/_waf_cookie.json

# Vendor-locating pipeline (scripts/gen_vendors.py): fetched caches and outputs.
/scripts/.cache/
/scripts/out/
/scripts/logs/
/scripts/export_buyprice/out/
/scripts/export_buyprice/output/
/scripts/export_npc_factions/output/

# Historical backups, logs and generated comparison reports.
/df-data-pipeline/_temp/_bak*
/df-data-pipeline/**/*.bak
/df-data-pipeline/**/*.log
/df-data-pipeline/_temp/*_report*.json
/df-data-pipeline/_temp/*_pre*.txt
/df-data-pipeline/_temp/*_post*.txt

# Known fetched-page prefixes; keep HTML tools such as _route_plan/tune.html.
/df-data-pipeline/_temp/wh_*.html
/df-data-pipeline/_temp/whb_*.html
/df-data-pipeline/_temp/whn_*.html
/df-data-pipeline/_temp/_bis_*.html
/df-data-pipeline/_temp/_bm_page.html
/df-data-pipeline/_temp/_cat2.html
/df-data-pipeline/_temp/_cdp_test.html

# Disposable debug output directories.
/df-data-pipeline/_temp/_gearvend/
/df-data-pipeline/_temp/_mapbake/
/df-data-pipeline/_temp/_mapcheck/
/df-data-pipeline/_temp/live/
/df-data-pipeline/_temp/screenshots/
/df-data-pipeline/_temp/_screenshots/
/df-data-pipeline/_temp/_shots/

# Editor and operating-system temporary files.
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# Release ZIPs, checksums, extracted packages and staging copies are artifacts.
/dist/
/DungeonsForever-*.zip
/DungeonsForever-*.zip.sha256
/.DungeonsForever-package-*.tmp
