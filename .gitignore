# Local implementation snapshots and dependency/test runtime.
/.implementation-backup/
/.pipeline-runtime/

# Python runtime and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Keep runtime Core/Data, active generators/tests, required _fc/data inputs,
# frozen _fc/inputs (including faction evidence), maintenance and translations.
# Do not ignore all _temp/ or all JSON/CSV/HTML/Lua/DB2 files.

