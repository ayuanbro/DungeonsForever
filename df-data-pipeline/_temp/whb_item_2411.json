:[],"dataTree":1,"markupDisabledEnvironments":{"ptr":true,"ptr2":true,"beta":false,"d4ptr":false,"d4beta":false,"classicptr":false},"imported":true,"importedAuthor":"RimfrostHuldra","importedSubject":":|"},{"commentv2":1,"number":6,"id":2665401,"nreplies":0,"sticky":0,"user":"Thottbot","body":"Look...To get this mount head to wetlands-menethil harbor. The vendor is there. But to ride this mount you should head to eastvale loggin camp at elwyn forest and train to do so. So no u don't auto learn to ride it by buying it! to the question askin if dwarves can ride horses here is what i say: man if u are near lvl 40 and u have the guts to get exalted with stormwind then gg and go buy the horse. Eitherwise you can buy it but u can't train the horse riding. That is the same for every race.e.x. if human wants to ride a tiger he needs to be exalted with darnassus. getting exalted with cities is a doable thing with the repeatable runecloth donation.But last time i logged in runecloths aren't dropped at lvl40 places...=P so at lvl 40 try to get ur own race's mount. Leave the mixin up for lvl 60!","date":"2006-04-08T09:34:23-05:00","rating":46,"indent":0,"roles":64,"deleted":0,"outofdate":0,"userRating":0,"replies":[],"dataTree":1,"markupDisabledEnvironments":{"ptr":true,"ptr2":true,"beta":false,"d4ptr":false,"d4beta":false,"classicptr":false},"imported":true,"importedAuthor":"Dreadk","importedSubject":"black stallion"},{"commentv2":1,"number":7,"id":2665424,"nreplies":0,"sticky":0,"user":"Thottbot","body":"Can anyone tell me how i can get this or any kind of mount other than the dwarf ram considering im a dwarf? Rather i mean how can i train in horse riding or anything other than ram riding?\n\nEdit: if this is possible at all","date":"2006-07-26T21:34:23-05:00","rating":2,"indent":0,"roles":64,"deleted":0,"outofdate":0,"userRating":0,"replies":[],"dataTree":1,"markupDisabledEnvironments":{"ptr":true,"ptr2":true,"beta":false,"d4ptr":false,"d4beta":false,"classicptr":false},"imp